{
  "Aspire": {
    "StackExchange": {
      "Redis": {
        "DisableTracing": false,
        "DisableMetrics": false,
        "DisableHealthChecks": false,
        "LocalCertificatePath": "/path/to/certificate.pfx",
        "InstanceName": "my-template:"
      }
    },
    "Telemetry": {
      "DisableHealthChecks": false
    }
  },
  "ConnectionStrings": {
    "RedisConnection": ""
  },
  "ExternalServices": {
    "OpenMeteo": {
      "Url": "https://api.open-meteo.com/",
      "Timeout": "00:00:30",
      "StandardRetry": {
        "Retry": {
          "BackoffType": "Linear",
          "UseJitter": false,
          "MaxRetryAttempts": 1
        }
      },
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "SamplingDuration": "00:00:30",
        "MinimumThroughput": 20,
        "BreakDuration": "00:00:15"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Polly": "Warning",
        "System": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.OpenTelemetry" ],
    "WriteTo": [
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
