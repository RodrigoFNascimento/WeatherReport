{
  "Aspire": {
    "StackExchange": {
      "Redis": {
        "DisableTracing": false,
        "DisableMetrics": false,
        "DisableHealthChecks": false,
        "LocalCertificatePath": "/path/to/certificate.pfx",
        "InstanceName": "my-template:"
      }
    },
    "Telemetry": {
      "DisableHealthChecks": false
    }
  },
  "ConnectionStrings": {
    "RedisConnection": ""
  },
  "ExternalServices": {
    "OpenMeteo": {
      "Url": "https://api.open-meteo.com/",
      "Timeout": "00:00:30"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
